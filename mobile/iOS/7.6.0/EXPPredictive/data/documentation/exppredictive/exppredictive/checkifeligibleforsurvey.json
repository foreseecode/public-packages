{"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"variants":[{"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"platforms":[{"beta":false,"unavailable":false,"deprecated":true}],"symbolKind":"method","modules":[{"name":"EXPPredictive"}],"role":"symbol","title":"checkIfEligibleForSurvey","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"roleHeading":"Type Method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user has met the loyalty threshold defined in your exp_configuration.json file."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"setSkipPoolingCheck:"}],"type":"paragraph"}]}]}]}],"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"fragments":[{"kind":"identifier","text":"EXPPredictive"}],"kind":"symbol","title":"EXPPredictive","type":"topic","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","role":"symbol","abstract":[{"type":"text","text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a"},{"type":"text","text":" "},{"type":"codeVoice","code":"exp_configuration.json"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"type":"text","text":" "},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"url":"\/documentation\/exppredictive\/exppredictive"},"setSkipPoolingCheck:":{"identifier":"setSkipPoolingCheck:","url":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","titleInlineContent":[{"text":"setSkipPoolingCheck:","type":"text"}],"type":"link"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","type":"topic","title":"checkIfEligibleForSurvey","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","kind":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}]},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"url":"\/documentation\/exppredictive","title":"EXPPredictive","kind":"symbol","abstract":[],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","type":"topic","role":"collection"}}}