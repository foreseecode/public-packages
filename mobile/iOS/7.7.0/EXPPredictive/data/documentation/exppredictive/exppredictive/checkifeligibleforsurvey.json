{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Type Method","modules":[{"name":"EXPPredictive"}],"title":"checkIfEligibleForSurvey","platforms":[{"beta":false,"deprecated":true,"unavailable":false}],"externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","role":"symbol","symbolKind":"method","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}]},"sections":[],"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"preciseIdentifier":"c:v","text":"void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS"],"languages":["occ"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The user has met the loyalty threshold defined in your exp_configuration.json file."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"setSkipPoolingCheck:"}],"type":"paragraph"}]}]}]}],"references":{"setSkipPoolingCheck:":{"titleInlineContent":[{"type":"text","text":"setSkipPoolingCheck:"}],"identifier":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","url":"setSkipPoolingCheck:","type":"link"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"title":"checkIfEligibleForSurvey","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","type":"topic","kind":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","role":"symbol"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"role":"symbol","title":"EXPPredictive","fragments":[{"kind":"identifier","text":"EXPPredictive"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a"},{"type":"text","text":" "},{"type":"codeVoice","code":"exp_configuration.json"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"type":"text","text":" "},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","url":"\/documentation\/exppredictive\/exppredictive"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"title":"EXPPredictive","abstract":[],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/exppredictive"}}}