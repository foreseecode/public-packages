{"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","text":"void","preciseIdentifier":"c:v"},{"kind":"text","text":") "},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The library is in an enabled state. If the user has previously declined an invite","type":"text"},{"text":" ","type":"text"},{"text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is","type":"text"},{"text":" ","type":"text"},{"text":"in an enabled state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user has met the loyalty threshold defined in your exp_configuration.json file."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"type":"reference","identifier":"setSkipPoolingCheck:","isActive":true}],"type":"paragraph"}]}],"type":"orderedList"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"metadata":{"symbolKind":"method","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"modules":[{"name":"EXPPredictive"}],"title":"checkIfEligibleForSurvey","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"role":"symbol","roleHeading":"Type Method","platforms":[{"unavailable":false,"deprecated":true,"beta":false}]},"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"title":"checkIfEligibleForSurvey","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","role":"symbol","type":"topic","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"kind":"symbol"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"kind":"symbol","role":"collection","abstract":[],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","type":"topic","title":"EXPPredictive","url":"\/documentation\/exppredictive"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"kind":"symbol","role":"symbol","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"code":"exp_configuration.json","type":"codeVoice"},{"text":" file to your project that defines the behavior of the Trigger module (e.g. defines the","type":"text"},{"text":" ","type":"text"},{"text":"triggering criteria for inviting a user to participate in a survey).","type":"text"}],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","url":"\/documentation\/exppredictive\/exppredictive","title":"EXPPredictive","type":"topic","fragments":[{"kind":"identifier","text":"EXPPredictive"}]},"setSkipPoolingCheck:":{"url":"setSkipPoolingCheck:","titleInlineContent":[{"text":"setSkipPoolingCheck:","type":"text"}],"title":"setSkipPoolingCheck:","type":"link","identifier":"setSkipPoolingCheck:"}}}