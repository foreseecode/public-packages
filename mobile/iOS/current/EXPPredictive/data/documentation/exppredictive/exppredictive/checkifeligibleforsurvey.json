/exppredictive\/exppredictive","abstract":[{"type":"text","text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a"},{"type":"text","text":" "},{"type":"codeVoice","code":"exp_configuration.json"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"text":" ","type":"text"},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"role":"symbol","fragments":[{"text":"EXPPredictive","kind":"identifier"}],"kind":"symbol","title":"EXPPredictive","type":"topic","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"}}}