{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey"},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"In order to be eligible, a number of conditions must be fulfilled:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"The library is in an enabled state. If the user has previously declined an invite","type":"text"},{"text":" ","type":"text"},{"text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is","type":"text"},{"text":" ","type":"text"},{"text":"in an enabled state.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"text":" ","type":"text"},{"text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,","type":"text"},{"text":" ","type":"text"},{"text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with","type":"text"},{"text":" ","type":"text"},{"identifier":"setSkipPoolingCheck:","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"orderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"metadata":{"roleHeading":"Type Method","platforms":[{"beta":false,"deprecated":true,"unavailable":false}],"navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"modules":[{"name":"EXPPredictive"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"symbolKind":"method","title":"checkIfEligibleForSurvey","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","role":"symbol"},"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"abstract":[],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","type":"topic","title":"EXPPredictive","url":"\/documentation\/exppredictive","role":"collection","kind":"symbol"},"setSkipPoolingCheck:":{"title":"setSkipPoolingCheck:","titleInlineContent":[{"type":"text","text":"setSkipPoolingCheck:"}],"url":"setSkipPoolingCheck:","identifier":"setSkipPoolingCheck:","type":"link"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","title":"EXPPredictive","url":"\/documentation\/exppredictive\/exppredictive","abstract":[{"type":"text","text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a"},{"type":"text","text":" "},{"type":"codeVoice","code":"exp_configuration.json"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"type":"text","text":" "},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"role":"symbol","fragments":[{"kind":"identifier","text":"EXPPredictive"}],"type":"topic","kind":"symbol"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"type":"topic","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"title":"checkIfEligibleForSurvey","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","kind":"symbol"}}}