the user is in the sampling pool. If s\/he is,","type":"text"},{"text":" ","type":"text"},{"text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with","type":"text"},{"text":" ","type":"text"},{"identifier":"setSkipPoolingCheck:","isActive":true,"type":"reference"}]}]}]}],"kind":"content"}],"sections":[],"metadata":{"platforms":[{"beta":false,"unavailable":false,"deprecated":true}],"role":"symbol","modules":[{"name":"EXPPredictive"}],"externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"symbolKind":"method","fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"roleHeading":"Type Method","title":"checkIfEligibleForSurvey"},"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"title":"EXPPredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","type":"topic","abstract":[],"url":"\/documentation\/exppredictive","kind":"symbol","role":"collection"},"setSkipPoolingCheck:":{"titleInlineContent":[{"text":"setSkipPoolingCheck:","type":"text"}],"identifier":"setSkipPoolingCheck:","url":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","type":"link"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"kind":"symbol","title":"EXPPredictive","role":"symbol","url":"\/documentation\/exppredictive\/exppredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"code":"exp_configuration.json","type":"codeVoice"},{"text":" file to your project that defines the behavior of the Trigger module (e.g. defines the","type":"text"},{"text":" ","type":"text"},{"text":"triggering criteria for inviting a user to participat