{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["occ"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"},{"kind":"text","text":";"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The library is in an enabled state. If the user has previously declined an invite","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"text":"in an enabled state.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user has met the loyalty threshold defined in your exp_configuration.json file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"text":" ","type":"text"},{"text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"text":" ","type":"text"},{"identifier":"setSkipPoolingCheck:","isActive":true,"type":"reference"}]}]}]}]}],"variants":[{"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"modules":[{"name":"EXPPredictive"}],"title":"checkIfEligibleForSurvey","role":"symbol","symbolKind":"method","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","roleHeading":"Type Method","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}]},"abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"kind":"symbol","references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","kind":"symbol","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"title":"checkIfEligibleForSurvey","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","role":"symbol","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"type":"topic"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"kind":"symbol","url":"\/documentation\/exppredictive","type":"topic","role":"collection","abstract":[],"title":"EXPPredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"abstract":[{"type":"text","text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a"},{"type":"text","text":" "},{"type":"codeVoice","code":"exp_configuration.json"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"type":"text","text":" "},{"text":"triggering criteria for inviting a user to participate in a survey).","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","title":"EXPPredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","fragments":[{"kind":"identifier","text":"EXPPredictive"}],"url":"\/documentation\/exppredictive\/exppredictive"},"setSkipPoolingCheck:":{"titleInlineContent":[{"type":"text","text":"setSkipPoolingCheck:"}],"identifier":"setSkipPoolingCheck:","type":"link","title":"setSkipPoolingCheck:","url":"setSkipPoolingCheck:"}}}