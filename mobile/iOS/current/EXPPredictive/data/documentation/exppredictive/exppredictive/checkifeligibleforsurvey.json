t":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"text":" ","type":"text"},{"text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,","type":"text"},{"text":" ","type":"text"},{"text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"setSkipPoolingCheck:","type":"reference"}]}]}]}]}],"kind":"symbol","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","role":"symbol","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"type":"topic","title":"checkIfEligibleForSurvey","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"kind":"symbol"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"type":"topic","title":"EXPPredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","abstract":[],"kind":"symbol","url":"\/documentation\/exppredictive","role":"collection"},"setSkipPoolingCheck:":{"title":"setSkipPoolingCheck:","url":"setSkipPoolingCheck:","identifier":"setSkipPoolingCheck:","titleInlineContent":[{"type":"text","text":"setSkipPoolingCheck:"}],"type":"link"},"doc://com.Verint.EXPPredictive/