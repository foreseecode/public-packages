{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"text":" ","type":"text"},{"text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,","type":"text"},{"text":" ","type":"text"},{"text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"setSkipPoolingCheck:"}]}]}],"type":"orderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],