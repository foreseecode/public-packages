{"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"+ ("},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"},{"kind":"text","text":";"}],"platforms":["iOS"],"languages":["occ"]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"identifier":"setSkipPoolingCheck:","isActive":true,"type":"reference"}]}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"metadata":{"externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","symbolKind":"method","title":"checkIfEligibleForSurvey","roleHeading":"Type Method","modules":[{"name":"EXPPredictive"}],"role":"symbol","fragments":[{"kind":"text","text":"+ "},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}]},"abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"references":{"setSkipPoolingCheck:":{"titleInlineContent":[{"type":"text","text":"setSkipPoolingCheck:"}],"type":"link","identifier":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","url":"setSkipPoolingCheck:"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"title":"EXPPredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","fragments":[{"text":"EXPPredictive","kind":"identifier"}],"url":"\/documentation\/exppredictive\/exppredictive","role":"symbol","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"exp_configuration.json"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"text":" ","type":"text"},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"kind":"symbol","type":"topic"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","abstract":[],"type":"topic","title":"EXPPredictive","kind":"symbol","role":"collection","url":"\/documentation\/exppredictive"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"title":"checkIfEligibleForSurvey","type":"topic","fragments":[{"kind":"text","text":"+ "},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"}}}