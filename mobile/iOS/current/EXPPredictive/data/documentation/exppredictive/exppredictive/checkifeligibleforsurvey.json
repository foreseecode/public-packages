{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}],"platforms":["iOS"],"languages":["occ"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"In order to be eligible, a number of conditions must be fulfilled:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user has met the loyalty threshold defined in your exp_configuration.json file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"type":"reference","identifier":"setSkipPoolingCheck:","isActive":true}]}]}]}],"kind":"content"}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"platforms":[{"unavailable":false,"beta":false,"deprecated":true}],"symbolKind":"method","roleHeading":"Type Method","role":"symbol","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","title":"checkIfEligibleForSurvey","modules":[{"name":"EXPPredictive"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}]},"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"kind":"symbol","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"sections":[],"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"fragments":[{"text":"EXPPredictive","kind":"identifier"}],"role":"symbol","title":"EXPPredictive","kind":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","url":"\/documentation\/exppredictive\/exppredictive","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"code":"exp_configuration.json","type":"codeVoice"},{"text":" file to your project that defines the behavior of the Trigger module (e.g. defines the","type":"text"},{"text":" ","type":"text"},{"text":"triggering criteria for inviting a user to participate in a survey).","type":"text"}],"type":"topic"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"type":"topic","role":"symbol","title":"checkIfEligibleForSurvey","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}]},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"title":"EXPPredictive","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/exppredictive","abstract":[],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive"},"setSkipPoolingCheck:":{"identifier":"setSkipPoolingCheck:","titleInlineContent":[{"type":"text","text":"setSkipPoolingCheck:"}],"url":"setSkipPoolingCheck:","type":"link","title":"setSkipPoolingCheck:"}}}