{"sections":[],"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"kind":"symbol","metadata":{"platforms":[{"deprecated":true,"beta":false,"unavailable":false}],"role":"symbol","roleHeading":"Type Method","symbolKind":"method","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"modules":[{"name":"EXPPredictive"}],"title":"checkIfEligibleForSurvey","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}]},"abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"type":"reference","identifier":"setSkipPoolingCheck:","isActive":true}]}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"references":{"setSkipPoolingCheck:":{"type":"link","identifier":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","titleInlineContent":[{"type":"text","text":"setSkipPoolingCheck:"}],"url":"setSkipPoolingCheck:"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","type":"topic","title":"checkIfEligibleForSurvey","navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"kind":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","role":"symbol","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}]},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"exp_configuration.json"},{"text":" file to your project that defines the behavior of the Trigger module (e.g. defines the","type":"text"},{"text":" ","type":"text"},{"text":"triggering criteria for inviting a user to participate in a survey).","type":"text"}],"fragments":[{"text":"EXPPredictive","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/exppredictive\/exppredictive","title":"EXPPredictive","type":"topic"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"type":"topic","role":"collection","url":"\/documentation\/exppredictive","kind":"symbol","title":"EXPPredictive","abstract":[],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive"}}}