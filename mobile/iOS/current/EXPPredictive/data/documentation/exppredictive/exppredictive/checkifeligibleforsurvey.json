{"metadata":{"modules":[{"name":"EXPPredictive"}],"platforms":[{"deprecated":true,"beta":false,"unavailable":false}],"roleHeading":"Type Method","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","role":"symbol","title":"checkIfEligibleForSurvey","symbolKind":"method","navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["occ"],"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","preciseIdentifier":"c:v","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"},{"text":";","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The library is in an enabled state. If the user has previously declined an invite","type":"text"},{"text":" ","type":"text"},{"text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is","type":"text"},{"text":" ","type":"text"},{"text":"in an enabled state.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"isActive":true,"identifier":"setSkipPoolingCheck:","type":"reference"}],"type":"paragraph"}]}],"type":"orderedList"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"kind":"symbol","url":"\/documentation\/exppredictive\/exppredictive","type":"topic","title":"EXPPredictive","role":"symbol","fragments":[{"kind":"identifier","text":"EXPPredictive"}],"abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"code":"exp_configuration.json","type":"codeVoice"},{"text":" file to your project that defines the behavior of the Trigger module (e.g. defines the","type":"text"},{"text":" ","type":"text"},{"text":"triggering criteria for inviting a user to participate in a survey).","type":"text"}],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"},"setSkipPoolingCheck:":{"identifier":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","titleInlineContent":[{"text":"setSkipPoolingCheck:","type":"text"}],"type":"link","url":"setSkipPoolingCheck:"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"abstract":[],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","url":"