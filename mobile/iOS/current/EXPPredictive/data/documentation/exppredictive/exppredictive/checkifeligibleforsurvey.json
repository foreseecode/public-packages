{"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"metadata":{"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"title":"checkIfEligibleForSurvey","roleHeading":"Type Method","symbolKind":"method","fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"modules":[{"name":"EXPPredictive"}],"role":"symbol","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["occ"],"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"},{"text":";","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The library is in an enabled state. If the user has previously declined an invite","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"text":"in an enabled state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user has met the loyalty threshold defined in your exp_configuration.json file."}]}]},{"content":[{"inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"type":"text","text":" "},{"text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,","type":"text"},{"type":"text","text":" "},{"text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with","type":"text"},{"type":"text","text":" "},{"isActive":true,"identifier":"setSkipPoolingCheck:","type":"reference"}],"type":"paragraph"}]}],"type":"orderedList"}]}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"title":"EXPPredictive","url":"\/documentation\/exppredictive\/exppredictive","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"code":"exp_configuration.json","type":"codeVoice"},{"text":" file to your project that defines the behavior of the Trigger module (e.g. defines the","type":"text"},{"type":"text","text":" "},{"text":"triggering criteria for inviting a user to participate in a survey).","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","fragments":[{"text":"EXPPredictive","kind":"identifier"}],"role":"symbol"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","url":"\/documentation\/exppredictive","type":"topic","role":"collection","abstract":[],"kind":"symbol","title":"EXPPredictive"},"setSkipPoolingCheck:":{"type":"link","identifier":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","titleInlineContent":[{"type":"text","text":"setSkipPoolin