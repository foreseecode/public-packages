{"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"In order to be eligible, a number of conditions must be fulfilled:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"setSkipPoolingCheck:"}]}]}],"type":"orderedList"}]}],"kind":"symbol","sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey"},"metadata":{"role":"symbol","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","roleHeading":"Type Method","title":"checkIfEligibleForSurvey","platforms":[{"deprecated":true,"unavailable":false,"beta":false}],"modules":[{"name":"EXPPredictive"}],"symbolKind":"method","navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}]},"references":{"setSkipPoolingCheck:":{"type":"link","identifier":"setSkipPoolingCheck:","url":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","titleInlineContent":[{"text":"setSkipPoolingCheck:","type":"text"}]},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"type":"topic","kind":"symbol","title":"checkIfEligibleForSurvey","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","role":"symbol","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"kind":"symbol","type":"topic","abstract":[],"title":"EXPPredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","url":"\/documentation\/exppredictive","role":"collection"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"kind":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","abstract":[{"type":"text","text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a"},{"type":"text","text":" "},{"code":"exp_configuration.json","type":"codeVoice"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"type":"text","text":" "},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"url":"\/documentation\/exppredictive\/exppredictive","role":"symbol","title":"EXPPredictive","fragments":[{"text":"EXPPredictive","kind":"identifier"}],"type":"topic"}}}