{"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"roleHeading":"Type Method","modules":[{"name":"EXPPredictive"}],"fragments":[{"kind":"text","text":"+ "},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"symbolKind":"method","title":"checkIfEligibleForSurvey","role":"symbol","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey"},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"kind":"symbol","abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"languages":["occ"],"tokens":[{"text":"+ (","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:v","text":"void"},{"text":") ","kind":"text"},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"text":" ","type":"text"},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"setSkipPoolingCheck:"}],"type":"paragraph"}]}]}],"kind":"content"}],"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"title":"EXPPredictive","role":"collection","url":"\/documentation\/exppredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","type":"topic","abstract":[],"kind":"symbol"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"title":"checkIfEligibleForSurvey","type":"topic","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","role":"symbol","fragments":[{"text":"+ ","kind":"text"},{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"kind":"symbol","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}]},"setSkipPoolingCheck:":{"type":"link","title":"setSkipPoolingCheck:","titleInlineContent":[{"type":"text","text":"setSkipPoolingCheck:"}],"identifier":"setSkipPoolingCheck:","url":"setSkipPoolingCheck:"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"title":"EXPPredictive","fragments":[{"text":"EXPPredictive","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"code":"exp_configuration.json","type":"codeVoice"},{"text":" file to your project that defines the behavior of the Trigger module (e.g. defines the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"role":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","url":"\/documentation\/exppredictive\/exppredictive"}}}