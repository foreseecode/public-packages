{"abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"metadata":{"platforms":[{"unavailable":false,"deprecated":true,"beta":false}],"navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"symbolKind":"method","role":"symbol","title":"checkIfEligibleForSurvey","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","roleHeading":"Type Method","modules":[{"name":"EXPPredictive"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","text":"void","preciseIdentifier":"c:v"},{"kind":"text","text":") "},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"In order to be eligible, a number of conditions must be fulfilled:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user has met the loyalty threshold defined in your exp_configuration.json file."}]}]},{"content":[{"inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"text":" ","type":"text"},{"text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,","type":"text"},{"text":" ","type":"text"},{"text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with","type":"text"},{"text":" ","type":"text"},{"identifier":"setSkipPoolingCheck:","isActive":true,"type":"reference"}],"type":"paragraph"}]}]}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"references":{"setSkipPoolingCheck:":{"type":"link","identifier":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","titleInlineContent":[{"text":"setSkipPoolingCheck:","type":"text"}],"url":"setSkipPoolingCheck:"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"role":"symbol","title":"checkIfEligibleForSurvey","type":"topic","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"type":"topic","role":"collection","url":"\/documentation\/exppredictive","title":"EXPPredictive","abstract":[],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","kind":"symbol"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","fragments":[{"text":"EXPPredictive","kind":"identifier"}],"role":"symbol","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"code":"exp_configuration.json","type":"codeVoice"},{"text":" file to your project that defines the behavior of the Trigger module (e.g. defines the","type":"text"},{"text":" ","type":"text"},{"text":"triggering criteria for inviting a user to participate in a survey).","type":"text"}],"url":"\/documentation\/exppredictive\/exppredictive","title":"EXPPredictive","kind":"symbol","type":"topic"}}}