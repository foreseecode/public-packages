{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"role":"symbol","symbolKind":"method","title":"checkIfEligibleForSurvey","roleHeading":"Type Method","modules":[{"name":"EXPPredictive"}],"platforms":[{"deprecated":true,"beta":false,"unavailable":false}],"externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}]},"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"text":"In order to be eligible, a number of conditions must be fulfilled:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"text":" ","type":"text"},{"text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,","type":"text"},{"text":" ","type":"text"},{"text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"setSkipPoolingCheck:","isActive":true}]}]}],"type":"orderedList"}]}],"sections":[],"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","navigatorTitle":[{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"role":"symbol","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"checkIfEligibleForSurvey"}],"title":"checkIfEligibleForSurvey","kind":"symbol","type":"topic","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}]},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","title":"EXPPredictive","type":"topic","kind":"symbol","url":"\/documentation\/exppredictive","abstract":[],"role":"collection"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"url":"\/documentation\/exppredictive\/exppredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","role":"symbol","kind":"symbol","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"exp_configuration.json"},{"text":" file to your project that defines the behavior of the Trigger module (e.g. defines the","type":"text"},{"text":" ","type":"text"},{"text":"triggering criteria for inviting a user to participate in a survey).","type":"text"}],"title":"EXPPredictive","type":"topic","fragments":[{"text":"EXPPredictive","kind":"identifier"}]},"setSkipPoolingCheck:":{"identifier":"setSkipPoolingCheck:","type":"link","title":"setSkipPoolingCheck:","url":"setSkipPoolingCheck:","titleInlineContent":[{"text":"setSkipPoolingCheck:","type":"text"}]}}}