{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Checks to see if the user is currently eligible to be invited to a survey."}],"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"variants":[{"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"metadata":{"roleHeading":"Type Method","symbolKind":"method","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","modules":[{"name":"EXPPredictive"}],"role":"symbol","title":"checkIfEligibleForSurvey","fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}]},"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The library is in an enabled state. If the user has previously declined an invite","type":"text"},{"type":"text","text":" "},{"text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is","type":"text"},{"type":"text","text":" "},{"text":"in an enabled state.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user has met the loyalty threshold defined in your exp_configuration.json file."}]}]},{"content":[{"inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"setSkipPoolingCheck:"}],"type":"paragraph"}]}]}]}],"sections":[],"kind":"symbol","references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"fragments":[{"text":"EXPPredictive","kind":"identifier"}],"kind":"symbol","type":"topic","title":"EXPPredictive","abstract":[{"text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a","type":"text"},{"text":" ","type":"text"},{"code":"exp_configuration.json","type":"codeVoice"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"type":"text","text":" "},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"role":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","url":"\/documentation\/exppredictive\/exppredictive"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"type":"topic","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","kind":"symbol","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"title":"checkIfEligibleForSurvey","role":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}]},"setSkipPoolingCheck:":{"title":"setSkipPoolingCheck:","type":"link","titleInlineContent":[{"text":"setSkipPoolingCheck:","type":"text"}],"url":"setSkipPoolingCheck:","identifier":"setSkipPoolingCheck:"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"type":"topic","role":"collection","url":"\/documentation\/exppredictive","abstract":[],"identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","kind":"symbol","title":"EXPPredictive"}}}