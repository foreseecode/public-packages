{"primaryContentSections":[{"declarations":[{"platforms":["iOS"],"tokens":[{"text":"+ (","kind":"text"},{"text":"void","preciseIdentifier":"c:v","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to be eligible, a number of conditions must be fulfilled:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"text":" ","type":"text"},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"text":" ","type":"text"},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"text":" ","type":"text"},{"type":"reference","identifier":"setSkipPoolingCheck:","isActive":true}],"type":"paragraph"}]}],"type":"orderedList"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"role":"symbol","title":"checkIfEligibleForSurvey","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","symbolKind":"method","roleHeadi