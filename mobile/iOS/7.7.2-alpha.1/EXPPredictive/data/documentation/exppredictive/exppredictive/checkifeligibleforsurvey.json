{"sections":[],"metadata":{"symbolKind":"method","platforms":[{"deprecated":true,"beta":false,"unavailable":false}],"externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","modules":[{"name":"EXPPredictive"}],"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"title":"checkIfEligibleForSurvey","roleHeading":"Type Method","role":"symbol"},"identifier":{"url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","interfaceLanguage":"occ"},"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"kind":"text","text":"+ ("},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}],"languages":["occ"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"In order to be eligible, a number of conditions must be fulfilled:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user has met the loyalty threshold defined in your exp_configuration.json file."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user is in the sampling pool. If the previous two conditions have been met, the library"},{"type":"text","text":" "},{"type":"text","text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,"},{"type":"text","text":" "},{"type":"text","text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with"},{"type":"text","text":" "},{"identifier":"setSkipPoolingCheck:","type":"reference","isActive":true}]}]}]}],"kind":"content"}],"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"kind":"symbol","variants":[{"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"url":"\/documentation\/exppredictive","title":"EXPPredictive","role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","abstract":[]},"setSkipPoolingCheck:":{"titleInlineContent":[{"type":"text","text":"setSkipPoolingCheck:"}],"type":"link","url":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:","identifier":"setSkipPoolingCheck:"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"kind":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"EXPPredictive"}],"url":"\/documentation\/exppredictive\/exppredictive","abstract":[{"type":"text","text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a"},{"type":"text","text":" "},{"type":"codeVoice","code":"exp_configuration.json"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"type":"text","text":" "},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"title":"EXPPredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive","role":"symbol"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"title":"checkIfEligibleForSurvey","url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","type":"topic","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey"}}}