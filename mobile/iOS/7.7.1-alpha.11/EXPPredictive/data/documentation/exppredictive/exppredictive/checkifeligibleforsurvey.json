{"abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive","doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"]]},"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"typeIdentifier","text":"void","preciseIdentifier":"c:v"},{"kind":"text","text":") "},{"kind":"identifier","text":"checkIfEligibleForSurvey"},{"kind":"text","text":";"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"In order to be eligible, a number of conditions must be fulfilled:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The library is in an enabled state. If the user has previously declined an invite"},{"type":"text","text":" "},{"type":"text","text":"or completed a survey, the library will be in a disabled state. Otherwise, the library is"},{"type":"text","text":" "},{"type":"text","text":"in an enabled state."}]}]},{"content":[{"inlineContent":[{"text":"The user has met the loyalty threshold defined in your exp_configuration.json file.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user is in the sampling pool. If the previous two conditions have been met, the library","type":"text"},{"text":" ","type":"text"},{"text":"makes an HTTP call to our servers to determine if the user is in the sampling pool. If s\/he is,","type":"text"},{"text":" ","type":"text"},{"text":"the invite will be presented. If not, the invite will not be shown. Disable this remote check with","type":"text"},{"text":" ","type":"text"},{"identifier":"setSkipPoolingCheck:","isActive":true,"type":"reference"}]}]}],"type":"orderedList"}],"kind":"content"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey"]}],"metadata":{"modules":[{"name":"EXPPredictive"}],"role":"symbol","symbolKind":"method","title":"checkIfEligibleForSurvey","externalID":"c:objc(cs)EXPPredictive(cm)checkIfEligibleForSurvey","navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"roleHeading":"Type Method","platforms":[{"unavailable":false,"beta":false,"deprecated":true}],"fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}]},"sections":[],"references":{"setSkipPoolingCheck:":{"identifier":"setSkipPoolingCheck:","type":"link","titleInlineContent":[{"text":"setSkipPoolingCheck:","type":"text"}],"url":"setSkipPoolingCheck:","title":"setSkipPoolingCheck:"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive":{"abstract":[],"url":"\/documentation\/exppredictive","role":"collection","kind":"symbol","type":"topic","title":"EXPPredictive","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive/checkIfEligibleForSurvey":{"fragments":[{"text":"+ ","kind":"text"},{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"navigatorTitle":[{"text":"checkIfEligibleForSurvey","kind":"identifier"}],"url":"\/documentation\/exppredictive\/exppredictive\/checkifeligibleforsurvey","title":"checkIfEligibleForSurvey","type":"topic","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive\/checkIfEligibleForSurvey","abstract":[{"text":"Checks to see if the user is currently eligible to be invited to a survey.","type":"text"}],"role":"symbol","kind":"symbol"},"doc://com.Verint.EXPPredictive/documentation/EXPPredictive/EXPPredictive":{"title":"EXPPredictive","role":"symbol","abstract":[{"type":"text","text":"The EXPPredictive class provides the main interface to the Verint EXPPredictive module. You must add a"},{"type":"text","text":" "},{"type":"codeVoice","code":"exp_configuration.json"},{"type":"text","text":" file to your project that defines the behavior of the Trigger module (e.g. defines the"},{"type":"text","text":" "},{"type":"text","text":"triggering criteria for inviting a user to participate in a survey)."}],"url":"\/documentation\/exppredictive\/exppredictive","fragments":[{"kind":"identifier","text":"EXPPredictive"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/com.Verint.EXPPredictive\/documentation\/EXPPredictive\/EXPPredictive"}}}